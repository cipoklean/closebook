# Closebook — secrets (NEVER commit this file; .env is gitignored)
# Copy to .env and fill in the values from sandbox.airwallex.com

# --- Airwallex sandbox credentials -------------------------------------
# From sandbox.airwallex.com  ->  Account > Developer > API keys
# (Use the business named "Sandbox Business" or "New Business Sandbox" so
#  onboarding auto-approves; other names stay "In review".)
AWX_CLIENT_ID=
AWX_API_KEY=
# Webhook secret: create the subscription in the sandbox web app under
# Settings > Developer > Webhooks (NOT via API); the secret shown there.
# If this is EMPTY, every incoming webhook is rejected (400) — that is
# deliberate: an unauthenticated webhook endpoint is a payment-injection risk.
AWX_WEBHOOK_SECRET=
# Set true ONLY to accept sandbox test events that carry the secret in a
# client-secret-key header. Default false.
AWX_ALLOW_TEST_EVENTS=false
# Base URL is fixed for the hackathon — do not point this at production.
AWX_BASE_URL=https://api.sandbox.airwallex.com

# --- LLM (optional) ----------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. Leave the key EMPTY to run
# fully deterministically — matching, policy and planning never call a model.
#
# The client is deliberately provider-neutral, so switching provider is a config
# change and never a code change. Known-good shapes:
#   OpenAI          LLM_BASE_URL=https://api.openai.com/v1
#   Gemini          LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   NVIDIA Build    LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Tried when the primary returns a 5xx or times out. Empty = no fallback.
# A 429 is treated differently on purpose: it is a THROTTLE, so the same model
# is retried with exponential backoff rather than swapped out.
LLM_FALLBACK_MODEL=

# Seconds to wait for the model. Keep this generous: a cold OpenAI-compatible
# request can take ~23s, and a 20s timeout renders as "the model proposed
# nothing" — a timeout reported as an answer.
LLM_TIMEOUT_S=45
# 429 retries on the primary, and the exponential backoff base in seconds.
LLM_MAX_RETRIES=3
LLM_BACKOFF_S=1.5
# Ask for a JSON object. The transport drops `response_format` and retries if the
# server rejects it, so this is safe on providers that do not implement it.
LLM_JSON_MODE=true
# Provider-specific request keys, merged into the body. Nothing here is
# provider-aware in the code, so a new endpoint is config only.
#   NVIDIA NIM, to skip the reasoning pass and answer faster:
#   LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=

# --- App / security ----------------------------------------------------
# Used to sign the approval-bundle hashes (any strong string, or empty).
CLOSEBOOK_HMAC_SECRET=
# Shared PIN required by POST /approvals/{id}/approve|reject (audit 8).
DEMO_APPROVER_PIN=
# Public URL where FastAPI is reachable, used for the webhook receiver:
#   make webhook-url        (cloudflared tunnel, prints the public URL)
PUBLIC_BASE_URL=http://localhost:8000
WEBHOOK_PATH=/webhooks/airwallex
LOG_LEVEL=INFO
LLM_TIMEOUT_S=45
